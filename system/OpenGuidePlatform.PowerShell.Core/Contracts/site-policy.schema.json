{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenGuidePlatform site policy v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "siteId": {
      "type": "string",
      "minLength": 1
    },
    "wrapper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discovery": { "const": "source" },
        "languageDirections": {
          "type": "object",
          "additionalProperties": { "enum": ["ltr", "rtl"] }
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
        },
        "requiredRoutes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "requiredFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
          },
          "minItems": 0
        },
        "requiredI18nKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "integrationPoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "requiredPageContent": {
          "items": {
            "additionalProperties": false,
            "required": [
              "route",
              "text"
            ],
            "type": "object",
            "properties": {
              "text": {
                "minLength": 1,
                "type": "string"
              },
              "route": {
                "minLength": 1,
                "type": "string"
              }
            }
          },
          "type": "array"
        },
        "runtimeAnchors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route",
              "fragment"
            ],
            "properties": {
              "route": {
                "type": "string",
                "pattern": "^/(?!/)(?!.*(?:\\\\|[?#%]|(?:^|/)\\.\\.(?:/|$))).*$"
              },
              "fragment": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "jsonFileNames": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "jsonIndexes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route",
              "requiredRoutes"
            ],
            "properties": {
              "route": {
                "type": "string",
                "pattern": "^/(?!/)(?!.*(?:\\\\|[?#%]|(?:^|/)\\.\\.(?:/|$))).*$"
              },
              "requiredRoutes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^/(?!/)(?!.*(?:\\\\|[?#%]|(?:^|/)\\.\\.(?:/|$))).*$"
                }
              }
            }
          }
        },
        "legacyAliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "language",
              "aliases",
              "targets"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+\\.md$"
              },
              "language": {
                "type": "string",
                "minLength": 2
              },
              "aliases": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^/(?:[A-Za-z0-9-]+/)?(?:download|downloads|translationsdirectory)/$"
                }
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9-]+/){0,2}(?:download|downloads|translationsdirectory)/index\\.html$"
                }
              }
            }
          }
        }
      },
      "required": [
        "sourcePath",
        "requiredRoutes",
        "requiredFiles",
        "requiredI18nKeys",
        "integrationPoints"
      ]
    },
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "contentRoot": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
          },
          "relationship": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "independent",
                  "core",
                  "extension"
                ]
              },
              "parentGuideId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "extension"
                    }
                  }
                },
                "then": {
                  "required": [
                    "parentGuideId"
                  ]
                }
              }
            ]
          },
          "protectSource": {
            "type": "boolean"
          },
          "editions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
                },
                "sourceLanguage": {
                  "type": "string",
                  "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
                },
                "translations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "language": {
                        "type": "string",
                        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
                      },
                      "intent": {
                        "enum": [
                          "web",
                          "pdf-only",
                          "fallback",
                          "scaffold",
                          "excluded"
                        ]
                      },
                      "fallbackLanguage": {
                        "type": "string",
                        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
                      },
                      "downloads": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
                            },
                            "handling": {
                              "enum": [
                                "supplied",
                                "generated",
                                "protected"
                              ]
                            },
                            "publicationRoots": { "type": "array", "items": { "type": "string" } },
                            "publishedPaths": {
                              "type": "array",
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:?#%]).+$"
                              },
                              "minItems": 1
                            },
                            "generationReceipt": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "path",
                                "environmentSha256"
                              ],
                              "properties": {
                                "path": {
                                  "type": "string",
                                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
                                },
                                "environmentSha256": {
                                  "type": "string",
                                  "pattern": "^[a-f0-9]{64}$"
                                }
                              }
                            }
                          },
                          "required": [
                            "path",
                            "handling"
                          ]
                        },
                        "minItems": 0
                      }
                    },
                    "required": [
                      "language",
                      "intent",
                      "downloads"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "intent": {
                              "const": "fallback"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "fallbackLanguage"
                          ]
                        }
                      },
                      {
                        "then": {
                          "properties": {
                            "downloads": {
                              "minItems": 1
                            }
                          }
                        },
                        "if": {
                          "properties": {
                            "intent": {
                              "const": "pdf-only"
                            }
                          }
                        }
                      }
                    ]
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "path",
                "sourceLanguage",
                "translations"
              ]
            },
            "minItems": 1
          },
          "artifactPrefixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:?#%]).+$"
            }
          }
        },
        "required": [
          "id",
          "contentRoot",
          "relationship",
          "protectSource",
          "editions"
        ]
      },
      "minItems": 1
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "enum": [
                  "local",
                  "canary",
                  "preview",
                  "production"
                ]
              },
              "excludedLanguages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
                },
                "minItems": 0
              },
              "excludedGuides": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "name",
              "excludedLanguages",
              "excludedGuides"
            ]
          },
          "minItems": 1
        },
        "permanentExclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "environment": {
                "enum": [
                  "canary",
                  "preview",
                  "production"
                ]
              },
              "subject": {
                "enum": [
                  "language",
                  "guide",
                  "edition"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "artifactPrefixes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:?#%]).+$"
                }
              }
            },
            "required": [
              "environment",
              "subject",
              "id",
              "reason"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "subject": {
                      "enum": [
                        "guide",
                        "edition"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "artifactPrefixes"
                  ]
                }
              }
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "environments",
        "permanentExclusions"
      ]
    },
    "protectedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "siteId",
    "wrapper",
    "guides",
    "publication",
    "protectedPaths"
  ]
}
